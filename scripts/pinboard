#!/bin/sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime_root="$plugin_root/.pinboard-runtime"
runtime_environment="$runtime_root/environment"
entry_name=pinboard
result_output_fd=1
ready_marker="$runtime_root/.pinboard-ready"
diagnostics="$runtime_root/.preparation-output"
preparation_action='{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["uv and write access to launcher-root .pinboard-runtime"]}'
export PYTHONDONTWRITEBYTECODE=1

launcher_result() {
    printf '{"schema":"pinboard-launcher-result/v1","status":"%s","pinboard_started":false,"runtime_location":{"base":"launcher-root","relative":".pinboard-runtime"},"observations":%s,"upstream_exit_code":%s,"retry_disposition":"%s","effect_disposition":"%s","changed_surfaces":%s,"next_action":%s}\n' \
        "$1" "$2" "$3" "$4" "$5" "$6" "$7" >&"$result_output_fd"
}

invalid_capture_arguments() {
    launcher_result \
        "invalid-capture-arguments" \
        '["Exact capture requires a caller-selected destination and --safe-to-persist-exactly."]' \
        "null" "correct-input" "unchanged" '[]' "null"
    exit 64
}

capture_flag_present() {
    for argument in "$@"; do
        case "$argument" in
            --capture-evidence|--capture-evidence=*|--capture-evidence-dir|--capture-evidence-dir=*|--safe-to-persist-exactly|--safe-to-persist-exactly=*)
                return 0
                ;;
        esac
    done
    return 1
}

capture_sha256() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        return 1
    fi
}

capture_bytes_json() {
    capture_byte_size=$(wc -c < "$1" | tr -d '[:space:]')
    capture_byte_sha256=$(capture_sha256 "$1") || return 1
    capture_byte_hex=$(od -An -v -tx1 "$1" | tr -d '[:space:]')
    printf '{"encoding":"hex","sha256":"%s","size_bytes":%s,"data":"%s"}' \
        "$capture_byte_sha256" "$capture_byte_size" "$capture_byte_hex"
}

write_capture_argv() {
    capture_argv_output=$1
    shift
    capture_argv_temporary=$1
    shift
    : > "$capture_argv_output"
    capture_separator=
    for capture_argument in "$@"; do
        printf '%s' "$capture_argument" > "$capture_argv_temporary"
        printf '%s' "$capture_separator" >> "$capture_argv_output"
        capture_bytes_json "$capture_argv_temporary" >> "$capture_argv_output"
        capture_separator=,
    done
}

capture_cleanup() {
    if [ -n "${capture_stage:-}" ]; then
        rm -f "$capture_stage" 2>/dev/null || :
    fi
    if [ -n "${capture_temporary:-}" ]; then
        rm -rf "$capture_temporary" 2>/dev/null || :
    fi
}

capture_interrupt() {
    capture_interrupted_status=$2
    if [ -n "${capture_child:-}" ]; then
        kill -"$1" "$capture_child" 2>/dev/null || :
    fi
}

capture_publication_failed() {
    cat "$capture_stdout"
    cat "$capture_stderr" >&2
    result_output_fd=2
    launcher_result \
        "capture-publication-failed" \
        '["The target ran once, but its exact capture could not be published. Do not replay a mutation to recover it."]' \
        "$capture_exit_status" "do-not-retry" "potentially-changed" '["target"]' "null"
    trap - EXIT HUP INT TERM
    capture_cleanup
    if [ -n "$capture_interrupted_status" ]; then
        exit "$capture_interrupted_status"
    fi
    exit 74
}

write_cli_capture() {
    {
        printf '{"schema":"pinboard-cli-invocation-capture/v1","selector":' &&
            capture_bytes_json "$capture_selector" &&
            printf ',"argv":[' &&
            cat "$capture_argv" &&
            printf '],"outcome":"%s","exit_status":%s,"stdout":' "$capture_outcome" "$capture_exit_status" &&
            capture_bytes_json "$capture_stdout" &&
            printf ',"stderr":' &&
            capture_bytes_json "$capture_stderr" &&
            printf ',"environment":"not-captured","presentation":"outer-presentation-unavailable","accepted_evidence":false}\n'
    } > "$capture_stage" || return 1
    chmod 600 "$capture_stage" || return 1
    ln "$capture_stage" "$capture_destination" 2>/dev/null || return 1
    return 0
}

capture_cli_invocation() {
    capture_selected_path=$1
    shift
    capture_parent=$(dirname -- "$capture_selected_path")
    capture_name=$(basename -- "$capture_selected_path")
    if [ "$capture_name" = "." ] || [ "$capture_name" = ".." ] || [ -z "$capture_name" ]; then
        invalid_capture_arguments
    fi
    if ! capture_parent=$(CDPATH= cd -- "$capture_parent" 2>/dev/null && pwd -P); then
        invalid_capture_arguments
    fi
    capture_destination="$capture_parent/$capture_name"
    if [ -e "$capture_destination" ] || [ -L "$capture_destination" ]; then
        invalid_capture_arguments
    fi
    if ! command -v mktemp >/dev/null 2>&1 || ! command -v od >/dev/null 2>&1 || \
        ! command -v awk >/dev/null 2>&1 || ! command -v tr >/dev/null 2>&1 || \
        ! command -v wc >/dev/null 2>&1 || ! command -v ln >/dev/null 2>&1 || \
        (! command -v shasum >/dev/null 2>&1 && ! command -v sha256sum >/dev/null 2>&1); then
        invalid_capture_arguments
    fi
    if ! capture_temporary=$(mktemp -d "$capture_parent/.pinboard-capture.XXXXXXXX"); then
        invalid_capture_arguments
    fi
    capture_stage=
    capture_child=
    capture_interrupted_status=
    trap capture_cleanup EXIT
    umask 077
    if ! capture_stage=$(mktemp "$capture_parent/.pinboard-capture-stage.XXXXXXXX"); then
        invalid_capture_arguments
    fi
    trap 'capture_interrupt HUP 129' HUP
    trap 'capture_interrupt INT 130' INT
    trap 'capture_interrupt TERM 143' TERM
    capture_stdout="$capture_temporary/stdout"
    capture_stderr="$capture_temporary/stderr"
    capture_argv="$capture_temporary/argv"
    capture_argument="$capture_temporary/argument"
    capture_selector="$capture_temporary/selector"
    write_capture_argv \
        "$capture_argv" \
        "$capture_argument" \
        "$0" \
        "--capture-evidence" \
        "$capture_selected_path" \
        "--safe-to-persist-exactly" \
        "--" \
        "$@"
    printf '%s' "$capture_selected_path" > "$capture_selector"
    "$0" "$@" > "$capture_stdout" 2> "$capture_stderr" &
    capture_child=$!
    if wait "$capture_child"; then
        capture_exit_status=0
    else
        capture_exit_status=$?
    fi
    if [ -n "$capture_interrupted_status" ]; then
        wait "$capture_child" 2>/dev/null || :
        capture_exit_status=$capture_interrupted_status
    fi
    capture_child=
    capture_outcome=completed
    if [ "$capture_exit_status" -ge 128 ]; then
        capture_outcome=interrupted
    fi
    if ! write_cli_capture; then
        capture_publication_failed
    fi
    rm -f "$capture_stage" 2>/dev/null || :
    capture_stage=
    cat "$capture_stdout"
    cat "$capture_stderr" >&2
    capture_cleanup
    trap - EXIT HUP INT TERM
    exit "$capture_exit_status"
}

if [ "$#" -ge 1 ] && [ "$1" = "--capture-evidence" ]; then
    if [ "$#" -lt 5 ] || [ "$3" != "--safe-to-persist-exactly" ] || [ "$4" != "--" ]; then
        invalid_capture_arguments
    fi
    case "$5" in
        --mcp|--claude-session-start|--claude-subagent-start)
            invalid_capture_arguments
            ;;
    esac
    capture_selected_path=$2
    shift 4
    capture_cli_invocation "$capture_selected_path" "$@"
fi

if [ "$#" -ge 1 ] && [ "$1" = "--mcp" ]; then
    entry_name=pinboard-mcp
    result_output_fd=2
    shift
    if [ "$#" -eq 3 ] && [ "$1" = "--capture-evidence-dir" ] && [ "$3" = "--safe-to-persist-exactly" ]; then
        if [ ! -d "$2" ]; then
            invalid_capture_arguments
        fi
    elif capture_flag_present "$@"; then
        invalid_capture_arguments
    elif [ "$#" -ne 0 ]; then
        launcher_result \
            "invalid-startup-arguments" \
            '["MCP startup accepts scripts/pinboard --mcp with only the optional complete capture declaration; project and work roots belong to tool requests."]' \
            "null" "correct-environment" "unchanged" '[]' "null"
        exit 64
    fi
elif capture_flag_present "$@"; then
    invalid_capture_arguments
fi
if [ "$#" -ge 1 ] && [ "$1" = "--claude-subagent-start" ]; then
    entry_name=pinboard-claude-subagent-start
    result_output_fd=2
    shift
    if [ "$#" -ne 0 ]; then
        launcher_result \
            "invalid-startup-arguments" \
            '["Claude SubagentStart startup accepts only scripts/pinboard --claude-subagent-start."]' \
            "null" "correct-environment" "unchanged" '[]' "null"
        exit 64
    fi
fi
if [ "$#" -ge 1 ] && [ "$1" = "--claude-session-start" ]; then
    entry_name=pinboard-claude-session-start
    result_output_fd=2
    shift
    if [ "$#" -ne 0 ]; then
        launcher_result \
            "invalid-startup-arguments" \
            '["Claude SessionStart startup accepts only scripts/pinboard --claude-session-start."]' \
            "null" "correct-environment" "unchanged" '[]' "null"
        exit 64
    fi
fi
if [ "$#" -ge 1 ] && [ "$1" = "--claude-pre-tool-use" ]; then
    entry_name=pinboard-claude-pre-tool-use
    result_output_fd=2
    shift
    if [ "$#" -ne 0 ]; then
        launcher_result \
            "invalid-startup-arguments" \
            '["Claude PreToolUse startup accepts only scripts/pinboard --claude-pre-tool-use."]' \
            "null" "correct-environment" "unchanged" '[]' "null"
        exit 64
    fi
fi
runtime_executable="$runtime_environment/bin/$entry_name"

runtime_write_failure() {
    launcher_result \
        "runtime-write-unavailable" \
        '["Pinboard could not write its launcher-root private runtime."]' \
        "$1" \
        "authorize-runtime-write" \
        "potentially-changed" \
        '[".pinboard-runtime"]' \
        '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["write access to launcher-root .pinboard-runtime"]}'
    exit 78
}

if [ "$#" -eq 1 ] && [ "$1" = "--prepare-runtime" ]; then
    if [ -f "$ready_marker" ] && [ -x "$runtime_executable" ] && [ -x "$runtime_environment/bin/pinboard-mcp" ] && [ -x "$runtime_environment/bin/pinboard-claude-subagent-start" ] && [ -x "$runtime_environment/bin/pinboard-claude-session-start" ] && [ -x "$runtime_environment/bin/pinboard-claude-pre-tool-use" ]; then
        launcher_result \
            "runtime-already-ready" \
            '["The launcher-root private runtime is already ready."]' \
            "null" \
            "retry-original-command" \
            "unchanged" \
            '[]' \
            "null"
        exit 0
    fi

    if ! command -v uv >/dev/null 2>&1; then
        launcher_result \
            "uv-unavailable" \
            '["Explicit runtime preparation requires uv."]' \
            "null" \
            "correct-environment" \
            "unchanged" \
            '[]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["uv"]}'
        exit 78
    fi

    if [ -e "$runtime_root" ] && [ ! -d "$runtime_root" ]; then
        printf 'launcher-root private runtime path is not a directory: %s\n' "$runtime_root" >&2
        runtime_write_failure 1
    fi
    if mkdir -p "$runtime_root" && rm -rf "$runtime_environment" "$ready_marker" "$diagnostics"; then
        :
    else
        upstream_exit_code=$?
        runtime_write_failure "$upstream_exit_code"
    fi

    if : > "$diagnostics"; then
        :
    else
        upstream_exit_code=$?
        runtime_write_failure "$upstream_exit_code"
    fi
    if UV_PROJECT_ENVIRONMENT="$runtime_environment" uv sync --locked --no-dev --project "$plugin_root" >"$diagnostics" 2>&1; then
        :
    else
        upstream_exit_code=$?
        cat "$diagnostics" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-sync-failed" \
            '["Locked synchronization of the launcher-root private runtime failed."]' \
            "$upstream_exit_code" \
            "correct-environment" \
            "potentially-changed" \
            '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a corrected uv environment/cache"]}'
        exit 78
    fi

    if "$runtime_executable" --version >"$diagnostics" 2>&1; then
        :
    else
        upstream_exit_code=$?
        cat "$diagnostics" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-entrypoint-invalid" \
            '["The locked private runtime Pinboard entry point failed verification."]' \
            "$upstream_exit_code" \
            "correct-environment" \
            "potentially-changed" \
            '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a valid locked runtime"]}'
        exit 78
    fi
    if [ ! -x "$runtime_environment/bin/pinboard-mcp" ]; then
        printf 'prepared MCP entry point is not executable: %s\n' "$runtime_environment/bin/pinboard-mcp" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-entrypoint-invalid" \
            '["The locked private runtime MCP entry point is missing or not executable."]' \
            "1" "correct-environment" "potentially-changed" '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a valid locked runtime"]}'
        exit 78
    fi
    if [ ! -x "$runtime_environment/bin/pinboard-claude-subagent-start" ]; then
        printf 'prepared Claude startup entry point is not executable: %s\n' "$runtime_environment/bin/pinboard-claude-subagent-start" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-entrypoint-invalid" \
            '["The locked private runtime Claude startup entry point is missing or not executable."]' \
            "1" "correct-environment" "potentially-changed" '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a valid locked runtime"]}'
        exit 78
    fi
    if [ ! -x "$runtime_environment/bin/pinboard-claude-session-start" ]; then
        printf 'prepared Claude parent startup entry point is not executable: %s\n' "$runtime_environment/bin/pinboard-claude-session-start" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-entrypoint-invalid" \
            '["The locked private runtime Claude parent startup entry point is missing or not executable."]' \
            "1" "correct-environment" "potentially-changed" '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a valid locked runtime"]}'
        exit 78
    fi
    if [ ! -x "$runtime_environment/bin/pinboard-claude-pre-tool-use" ]; then
        printf 'prepared Claude permission entry point is not executable: %s\n' "$runtime_environment/bin/pinboard-claude-pre-tool-use" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-entrypoint-invalid" \
            '["The locked private runtime Claude permission entry point is missing or not executable."]' \
            "1" "correct-environment" "potentially-changed" '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a valid locked runtime"]}'
        exit 78
    fi
    if rm -f "$diagnostics" && (: > "$ready_marker"); then
        launcher_result \
            "runtime-ready" \
            '["The launcher-root private runtime is ready."]' \
            "null" \
            "retry-original-command" \
            "changed" \
            '[".pinboard-runtime"]' \
            "null"
        exit 0
    else
        upstream_exit_code=$?
        runtime_write_failure "$upstream_exit_code"
    fi
fi

if [ -x "$plugin_root/.venv/bin/$entry_name" ]; then
    exec "$plugin_root/.venv/bin/$entry_name" "$@"
fi
if [ -f "$ready_marker" ] && [ -x "$runtime_executable" ]; then
    exec "$runtime_executable" "$@"
fi

preparation_required() {
    launcher_result \
        "runtime-preparation-required" \
        '["Pinboard has no ready launcher-root runtime."]' \
        "null" \
        "run-preparation" \
        "unchanged" \
        '[]' \
        "$preparation_action"
}
if [ "$entry_name" = "pinboard-mcp" ]; then
    preparation_lock="$runtime_root/.preparing"
    if ! command -v uv >/dev/null 2>&1; then
        preparation_exit_code=0
        preparation=$("$0" --prepare-runtime </dev/null) || preparation_exit_code=$?
        printf '%s\n' "$preparation" >&2
        exit "$preparation_exit_code"
    fi
    if ! mkdir -p "$runtime_root" 2>/dev/null || ! mkdir "$preparation_lock" 2>/dev/null; then
        preparation_required
        exit 78
    fi
    preparation_exit_code=0
    preparation=$("$0" --prepare-runtime </dev/null) || preparation_exit_code=$?
    rmdir "$preparation_lock" 2>/dev/null || true
    printf '%s\n' "$preparation" >&2
    preparation_status=$(printf '%s' "$preparation" | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
    if [ "$preparation_status" = "runtime-ready" ] || [ "$preparation_status" = "runtime-already-ready" ]; then
        if [ -f "$ready_marker" ] && [ -x "$runtime_executable" ]; then
            exec "$runtime_executable" "$@"
        fi
    fi
    if [ "$preparation_exit_code" -eq 0 ]; then
        preparation_required
        exit 78
    fi
    exit "$preparation_exit_code"
fi
if [ "$entry_name" != "pinboard-claude-session-start" ]; then
    preparation_required
    exit 78
fi
# SessionStart stdout is the agent's context channel, not a protocol stream. The hook is the
# nearest supported install trigger, so it runs the same explicit preparation path once and
# otherwise names the exact manual route instead of leaving the failed connection opaque.
hook_context() {
    preparation_required
    escaped=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$escaped"
    exit 0
}
manual_route="Run exactly $plugin_root/scripts/pinboard --prepare-runtime once with uv available; it writes only $plugin_root/.pinboard-runtime. When it reports runtime-ready, restart Claude Code or reconnect the pinboard MCP server. Do not substitute another Python environment or an ad hoc uv command."
failed_start="Claude Code reports the pinboard MCP server as failed (Connection closed) because this plugin version had no prepared private runtime when the session started."
if ! command -v uv >/dev/null 2>&1; then
    hook_context "$failed_start Pinboard could not prepare it automatically because uv is not on PATH. Tell the user. $manual_route"
fi
preparation_lock="$runtime_root/.preparing"
if ! mkdir -p "$runtime_root" 2>/dev/null || ! mkdir "$preparation_lock" 2>/dev/null; then
    hook_context "$failed_start Another Claude Code session is preparing that runtime now, or the lock directory $preparation_lock is stale. Tell the user: when the other session finishes, restart Claude Code or reconnect the pinboard MCP server; if no other session is running, remove that lock directory first. $manual_route"
fi
preparation=$("$0" --prepare-runtime </dev/null) || true
rmdir "$preparation_lock" 2>/dev/null || true
preparation_status=$(printf '%s' "$preparation" | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
if [ "$preparation_status" = "runtime-ready" ] && [ -f "$ready_marker" ] && [ -x "$runtime_executable" ]; then
    PINBOARD_RUNTIME_PREPARED_NOW=1 exec "$runtime_executable"
fi
hook_context "$failed_start Pinboard tried to prepare it automatically during this session start and failed with status ${preparation_status:-unknown}; the launcher diagnostics are on this hook's stderr. Tell the user. $manual_route"
