#!/bin/sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime_root="$plugin_root/.pinboard-runtime"
runtime_environment="$runtime_root/environment"
entry_name=pinboard
result_output_fd=1
ready_marker="$runtime_root/.pinboard-ready"
diagnostics="$runtime_root/.preparation-output"
preparation_action='{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["uv and write access to launcher-root .pinboard-runtime"]}'
export PYTHONDONTWRITEBYTECODE=1

launcher_result() {
    printf '{"schema":"pinboard-launcher-result/v1","status":"%s","pinboard_started":false,"runtime_location":{"base":"launcher-root","relative":".pinboard-runtime"},"observations":%s,"upstream_exit_code":%s,"retry_disposition":"%s","effect_disposition":"%s","changed_surfaces":%s,"next_action":%s}\n' \
        "$1" "$2" "$3" "$4" "$5" "$6" "$7" >&"$result_output_fd"
}

if [ "$#" -ge 1 ] && [ "$1" = "--mcp" ]; then
    entry_name=pinboard-mcp
    result_output_fd=2
    shift
    if [ "$#" -ne 0 ]; then
        launcher_result \
            "invalid-startup-arguments" \
            '["MCP startup accepts only scripts/pinboard --mcp; project and work roots belong to tool requests."]' \
            "null" "correct-environment" "unchanged" '[]' "null"
        exit 64
    fi
fi
if [ "$#" -ge 1 ] && [ "$1" = "--claude-subagent-start" ]; then
    entry_name=pinboard-claude-subagent-start
    result_output_fd=2
    shift
    if [ "$#" -ne 0 ]; then
        launcher_result \
            "invalid-startup-arguments" \
            '["Claude SubagentStart startup accepts only scripts/pinboard --claude-subagent-start."]' \
            "null" "correct-environment" "unchanged" '[]' "null"
        exit 64
    fi
fi
if [ "$#" -ge 1 ] && [ "$1" = "--claude-session-start" ]; then
    entry_name=pinboard-claude-session-start
    result_output_fd=2
    shift
    if [ "$#" -ne 0 ]; then
        launcher_result \
            "invalid-startup-arguments" \
            '["Claude SessionStart startup accepts only scripts/pinboard --claude-session-start."]' \
            "null" "correct-environment" "unchanged" '[]' "null"
        exit 64
    fi
fi
runtime_executable="$runtime_environment/bin/$entry_name"

runtime_write_failure() {
    launcher_result \
        "runtime-write-unavailable" \
        '["Pinboard could not write its launcher-root private runtime."]' \
        "$1" \
        "authorize-runtime-write" \
        "potentially-changed" \
        '[".pinboard-runtime"]' \
        '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["write access to launcher-root .pinboard-runtime"]}'
    exit 78
}

if [ "$#" -eq 1 ] && [ "$1" = "--prepare-runtime" ]; then
    if [ -f "$ready_marker" ] && [ -x "$runtime_executable" ] && [ -x "$runtime_environment/bin/pinboard-mcp" ] && [ -x "$runtime_environment/bin/pinboard-claude-subagent-start" ] && [ -x "$runtime_environment/bin/pinboard-claude-session-start" ]; then
        launcher_result \
            "runtime-already-ready" \
            '["The launcher-root private runtime is already ready."]' \
            "null" \
            "retry-original-command" \
            "unchanged" \
            '[]' \
            "null"
        exit 0
    fi

    if ! command -v uv >/dev/null 2>&1; then
        launcher_result \
            "uv-unavailable" \
            '["Explicit runtime preparation requires uv."]' \
            "null" \
            "correct-environment" \
            "unchanged" \
            '[]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["uv"]}'
        exit 78
    fi

    if [ -e "$runtime_root" ] && [ ! -d "$runtime_root" ]; then
        printf 'launcher-root private runtime path is not a directory: %s\n' "$runtime_root" >&2
        runtime_write_failure 1
    fi
    if mkdir -p "$runtime_root" && rm -rf "$runtime_environment" "$ready_marker" "$diagnostics"; then
        :
    else
        upstream_exit_code=$?
        runtime_write_failure "$upstream_exit_code"
    fi

    if : > "$diagnostics"; then
        :
    else
        upstream_exit_code=$?
        runtime_write_failure "$upstream_exit_code"
    fi
    if UV_PROJECT_ENVIRONMENT="$runtime_environment" uv sync --locked --no-dev --project "$plugin_root" >"$diagnostics" 2>&1; then
        :
    else
        upstream_exit_code=$?
        cat "$diagnostics" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-sync-failed" \
            '["Locked synchronization of the launcher-root private runtime failed."]' \
            "$upstream_exit_code" \
            "correct-environment" \
            "potentially-changed" \
            '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a corrected uv environment/cache"]}'
        exit 78
    fi

    if "$runtime_executable" --version >"$diagnostics" 2>&1; then
        :
    else
        upstream_exit_code=$?
        cat "$diagnostics" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-entrypoint-invalid" \
            '["The locked private runtime Pinboard entry point failed verification."]' \
            "$upstream_exit_code" \
            "correct-environment" \
            "potentially-changed" \
            '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a valid locked runtime"]}'
        exit 78
    fi
    if [ ! -x "$runtime_environment/bin/pinboard-mcp" ]; then
        printf 'prepared MCP entry point is not executable: %s\n' "$runtime_environment/bin/pinboard-mcp" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-entrypoint-invalid" \
            '["The locked private runtime MCP entry point is missing or not executable."]' \
            "1" "correct-environment" "potentially-changed" '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a valid locked runtime"]}'
        exit 78
    fi
    if [ ! -x "$runtime_environment/bin/pinboard-claude-subagent-start" ]; then
        printf 'prepared Claude startup entry point is not executable: %s\n' "$runtime_environment/bin/pinboard-claude-subagent-start" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-entrypoint-invalid" \
            '["The locked private runtime Claude startup entry point is missing or not executable."]' \
            "1" "correct-environment" "potentially-changed" '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a valid locked runtime"]}'
        exit 78
    fi
    if [ ! -x "$runtime_environment/bin/pinboard-claude-session-start" ]; then
        printf 'prepared Claude parent startup entry point is not executable: %s\n' "$runtime_environment/bin/pinboard-claude-session-start" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-entrypoint-invalid" \
            '["The locked private runtime Claude parent startup entry point is missing or not executable."]' \
            "1" "correct-environment" "potentially-changed" '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a valid locked runtime"]}'
        exit 78
    fi
    if rm -f "$diagnostics" && (: > "$ready_marker"); then
        launcher_result \
            "runtime-ready" \
            '["The launcher-root private runtime is ready."]' \
            "null" \
            "retry-original-command" \
            "changed" \
            '[".pinboard-runtime"]' \
            "null"
        exit 0
    else
        upstream_exit_code=$?
        runtime_write_failure "$upstream_exit_code"
    fi
fi

if [ -x "$plugin_root/.venv/bin/$entry_name" ]; then
    exec "$plugin_root/.venv/bin/$entry_name" "$@"
fi
if [ -f "$ready_marker" ] && [ -x "$runtime_executable" ]; then
    exec "$runtime_executable" "$@"
fi

preparation_required() {
    launcher_result \
        "runtime-preparation-required" \
        '["Pinboard has no ready launcher-root runtime."]' \
        "null" \
        "run-preparation" \
        "unchanged" \
        '[]' \
        "$preparation_action"
}
if [ "$entry_name" != "pinboard-claude-session-start" ]; then
    preparation_required
    exit 78
fi
# SessionStart stdout is the agent's context channel, not a protocol stream. The hook is the
# nearest supported install trigger, so it runs the same explicit preparation path once and
# otherwise names the exact manual route instead of leaving the failed connection opaque.
hook_context() {
    preparation_required
    escaped=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$escaped"
    exit 0
}
manual_route="Run exactly $plugin_root/scripts/pinboard --prepare-runtime once with uv available; it writes only $plugin_root/.pinboard-runtime. When it reports runtime-ready, restart Claude Code or reconnect the pinboard MCP server. Do not substitute another Python environment or an ad hoc uv command."
failed_start="Claude Code reports the pinboard MCP server as failed (Connection closed) because this plugin version had no prepared private runtime when the session started."
if ! command -v uv >/dev/null 2>&1; then
    hook_context "$failed_start Pinboard could not prepare it automatically because uv is not on PATH. Tell the user. $manual_route"
fi
preparation_lock="$runtime_root/.preparing"
if ! mkdir -p "$runtime_root" 2>/dev/null || ! mkdir "$preparation_lock" 2>/dev/null; then
    hook_context "$failed_start Another Claude Code session is preparing that runtime now, or the lock directory $preparation_lock is stale. Tell the user: when the other session finishes, restart Claude Code or reconnect the pinboard MCP server; if no other session is running, remove that lock directory first. $manual_route"
fi
preparation=$("$0" --prepare-runtime </dev/null) || true
rmdir "$preparation_lock" 2>/dev/null || true
preparation_status=$(printf '%s' "$preparation" | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
if [ "$preparation_status" = "runtime-ready" ] && [ -f "$ready_marker" ] && [ -x "$runtime_executable" ]; then
    PINBOARD_RUNTIME_PREPARED_NOW=1 exec "$runtime_executable"
fi
hook_context "$failed_start Pinboard tried to prepare it automatically during this session start and failed with status ${preparation_status:-unknown}; the launcher diagnostics are on this hook's stderr. Tell the user. $manual_route"
