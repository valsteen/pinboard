#!/bin/sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime_root="$plugin_root/.pinboard-runtime"
runtime_environment="$runtime_root/environment"
entry_name=pinboard
result_output_fd=1
ready_marker="$runtime_root/.pinboard-ready"
diagnostics="$runtime_root/.preparation-output"
preparation_lock="$runtime_root/.preparing"
preparation_action='{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["uv and write access to launcher-root .pinboard-runtime"]}'
export PYTHONDONTWRITEBYTECODE=1

# Scan executable, hook event label, and post-install diagnostic label in readiness order without temporary files.
check_runtime_entries() {
    runtime_check=$1
    requested_hook=${2:-}
    set -- \
        'pinboard||' \
        'pinboard-mcp||MCP' \
        'pinboard-claude-subagent-start|Claude SubagentStart|Claude startup' \
        'pinboard-claude-session-start|Claude SessionStart|Claude parent startup' \
        'pinboard-claude-pre-tool-use|Claude PreToolUse|Claude permission' \
        'pinboard-antigravity-session-start|Antigravity SessionStart|Antigravity startup' \
        'pinboard-antigravity-pre-tool-use|Antigravity PreToolUse|Antigravity permission'
    for runtime_row; do
        runtime_entry=${runtime_row%%|*}
        runtime_labels=${runtime_row#*|}
        hook_label=${runtime_labels%%|*}
        readiness_label=${runtime_labels#*|}
        case "$runtime_check" in
            startup)
                [ -n "$hook_label" ] || continue
                hook_flag="--${runtime_entry#pinboard-}"
                if [ "$requested_hook" = "$hook_flag" ]; then
                    return 0
                fi
                ;;
            ready|installed)
                if [ "$runtime_check" = installed ] && [ -z "$readiness_label" ]; then
                    continue
                fi
                runtime_entry_path="$runtime_environment/bin/$runtime_entry"
                [ -x "$runtime_entry_path" ] || return 1
                ;;
        esac
    done
    [ "$runtime_check" = ready ] || [ "$runtime_check" = installed ]
}

launcher_result() {
    printf '{"schema":"pinboard-launcher-result/v1","status":"%s","pinboard_started":false,"runtime_location":{"base":"launcher-root","relative":".pinboard-runtime"},"observations":%s,"upstream_exit_code":%s,"retry_disposition":"%s","effect_disposition":"%s","changed_surfaces":%s,"next_action":%s}\n' \
        "$1" "$2" "$3" "$4" "$5" "$6" "$7" >&"$result_output_fd"
}

invalid_capture_arguments() {
    launcher_result \
        "invalid-capture-arguments" \
        "[\"$1\"]" \
        "null" "correct-input" "unchanged" '[]' "null"
    exit 64
}

capture_flag_present() {
    for argument in "$@"; do
        case "$argument" in
            --capture-evidence|--capture-evidence=*|--capture-evidence-dir|--capture-evidence-dir=*|--safe-to-persist-exactly|--safe-to-persist-exactly=*)
                return 0
                ;;
        esac
    done
    return 1
}

if [ "$#" -ge 1 ] && [ "$1" = "--mcp" ]; then
    entry_name=pinboard-mcp
    result_output_fd=2
    shift
    if [ "$#" -eq 3 ] && [ "$1" = "--capture-evidence-dir" ] && [ "$3" = "--safe-to-persist-exactly" ]; then
        if [ ! -d "$2" ]; then
            invalid_capture_arguments 'MCP capture requires an existing selected directory; restore that directory or choose the intended existing directory.'
        fi
    elif capture_flag_present "$@"; then
        invalid_capture_arguments 'Use --mcp --capture-evidence-dir <existing-directory> --safe-to-persist-exactly with no partial capture declaration.'
    elif [ "$#" -ne 0 ]; then
        launcher_result \
            "invalid-startup-arguments" \
            '["MCP startup accepts scripts/pinboard --mcp with only the optional complete capture declaration; project and work roots belong to tool requests."]' \
            "null" "correct-environment" "unchanged" '[]' "null"
        exit 64
    fi
elif [ "${1:-}" != "--capture-evidence" ] && capture_flag_present "$@"; then
    # A leading --capture-evidence is the manual CLI capture form, which Python validates and runs.
    invalid_capture_arguments 'Choose the complete supported CLI or MCP capture declaration; do not mix capture flags into an ordinary invocation.'
fi
if check_runtime_entries startup "${1:-}"; then
    entry_name=$runtime_entry
    result_output_fd=2
    shift
    if [ "$#" -ne 0 ]; then
        launcher_result \
            "invalid-startup-arguments" \
            "[\"$hook_label startup accepts only scripts/pinboard $hook_flag.\"]" \
            "null" "correct-environment" "unchanged" '[]' "null"
        exit 64
    fi
fi
runtime_executable="$runtime_environment/bin/$entry_name"

runtime_write_failure() {
    launcher_result \
        "runtime-write-unavailable" \
        '["Pinboard could not write its launcher-root private runtime."]' \
        "$1" \
        "authorize-runtime-write" \
        "potentially-changed" \
        '[".pinboard-runtime"]' \
        '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["write access to launcher-root .pinboard-runtime"]}'
    exit 78
}

preparation_required() {
    launcher_result \
        "runtime-preparation-required" \
        "$1" \
        "null" "run-preparation" "unchanged" '[]' "$preparation_action"
}

release_preparation_lock() {
    if [ "${preparation_lock_held:-0}" = 1 ]; then
        rmdir "$preparation_lock" 2>/dev/null || :
        preparation_lock_held=0
    fi
}

runtime_entry_not_executable() {
    printf 'prepared %s entry point is not executable: %s\n' "$readiness_label" "$runtime_entry_path" >&2
    rm -f "$diagnostics"
    launcher_result \
        "runtime-entrypoint-invalid" \
        "[\"The locked private runtime $readiness_label entry point is missing or not executable.\"]" \
        "1" "correct-environment" "potentially-changed" '[".pinboard-runtime"]' \
        '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a valid locked runtime"]}'
    exit 78
}

if [ "$#" -eq 1 ] && [ "$1" = "--prepare-runtime" ]; then
    if [ -f "$ready_marker" ] && check_runtime_entries ready; then
        launcher_result \
            "runtime-already-ready" \
            '["The launcher-root private runtime is already ready."]' \
            "null" \
            "retry-original-command" \
            "unchanged" \
            '[]' \
            "null"
        exit 0
    fi

    if ! command -v uv >/dev/null 2>&1; then
        launcher_result \
            "uv-unavailable" \
            '["Explicit runtime preparation requires uv."]' \
            "null" \
            "correct-environment" \
            "unchanged" \
            '[]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["uv"]}'
        exit 78
    fi

    if [ -e "$runtime_root" ] && [ ! -d "$runtime_root" ]; then
        printf 'launcher-root private runtime path is not a directory: %s\n' "$runtime_root" >&2
        runtime_write_failure 1
    fi
    if ! mkdir -p "$runtime_root" 2>/dev/null; then
        preparation_required '["Cannot create launcher-root .pinboard-runtime; request write access to that exact directory before retrying the returned preparation action. The target did not run."]'
        exit 78
    fi
    if ! mkdir "$preparation_lock" 2>/dev/null; then
        if [ -d "$preparation_lock" ]; then
            preparation_required '["Launcher-root .pinboard-runtime/.preparing already exists. Wait for the current preparer to finish before retrying; if no preparer is running, report this exact stale lock to the human for diagnosis. Do not remove an active lock. The target did not run."]'
        else
            preparation_required '["Cannot create launcher-root .pinboard-runtime/.preparing; ask the human to inspect that exact path for a conflicting entry or unavailable directory write access before retrying preparation. The target did not run."]'
        fi
        exit 78
    fi
    preparation_lock_held=1
    trap release_preparation_lock EXIT
    if mkdir -p "$runtime_root" && rm -rf "$runtime_environment" "$ready_marker" "$diagnostics"; then
        :
    else
        upstream_exit_code=$?
        runtime_write_failure "$upstream_exit_code"
    fi

    if : > "$diagnostics"; then
        :
    else
        upstream_exit_code=$?
        runtime_write_failure "$upstream_exit_code"
    fi
    if UV_PROJECT_ENVIRONMENT="$runtime_environment" uv sync --locked --no-dev --project "$plugin_root" >"$diagnostics" 2>&1; then
        :
    else
        upstream_exit_code=$?
        cat "$diagnostics" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-sync-failed" \
            '["Locked synchronization of the launcher-root private runtime failed."]' \
            "$upstream_exit_code" \
            "correct-environment" \
            "potentially-changed" \
            '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a corrected uv environment/cache"]}'
        exit 78
    fi

    if "$runtime_executable" --version >"$diagnostics" 2>&1; then
        :
    else
        upstream_exit_code=$?
        cat "$diagnostics" >&2
        rm -f "$diagnostics"
        launcher_result \
            "runtime-entrypoint-invalid" \
            '["The locked private runtime Pinboard entry point failed verification."]' \
            "$upstream_exit_code" \
            "correct-environment" \
            "potentially-changed" \
            '[".pinboard-runtime"]' \
            '{"launcher":"self","arguments":["--prepare-runtime"],"display_command":"scripts/pinboard --prepare-runtime","requires":["a valid locked runtime"]}'
        exit 78
    fi
    check_runtime_entries installed || runtime_entry_not_executable
    if rm -f "$diagnostics" && (: > "$ready_marker"); then
        launcher_result \
            "runtime-ready" \
            '["The launcher-root private runtime is ready."]' \
            "null" \
            "retry-original-command" \
            "changed" \
            '[".pinboard-runtime"]' \
            "null"
        exit 0
    else
        upstream_exit_code=$?
        runtime_write_failure "$upstream_exit_code"
    fi
fi

selected_executable=
if [ -x "$plugin_root/.venv/bin/$entry_name" ]; then
    selected_executable="$plugin_root/.venv/bin/$entry_name"
elif [ -f "$ready_marker" ] && [ -x "$runtime_executable" ]; then
    selected_executable="$runtime_executable"
fi
if [ -n "$selected_executable" ]; then
    # Only the CLI learns its launcher path: Python records it as argv[0] and traces only launcher calls.
    if [ "$entry_name" = pinboard ]; then
        PINBOARD_LAUNCHER_PATH=$0 exec "$selected_executable" "$@"
    fi
    exec "$selected_executable" "$@"
fi

if [ "$entry_name" = "pinboard-mcp" ]; then
    preparation_exit_code=0
    preparation=$("$0" --prepare-runtime </dev/null) || preparation_exit_code=$?
    printf '%s\n' "$preparation" >&2
    preparation_status=$(printf '%s' "$preparation" | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
    if [ "$preparation_status" = "runtime-ready" ] || [ "$preparation_status" = "runtime-already-ready" ]; then
        if [ -f "$ready_marker" ] && [ -x "$runtime_executable" ]; then
            exec "$runtime_executable" "$@"
        fi
    fi
    if [ "$preparation_exit_code" -eq 0 ]; then
        preparation_required '["Pinboard has no ready launcher-root private runtime; run the returned same-launcher preparation action before retrying the original command."]'
        exit 78
    fi
    exit "$preparation_exit_code"
fi
case "$entry_name" in
    pinboard-claude-session-start)
        session_client="Claude Code"
        reconnect_route="restart Claude Code or reconnect the pinboard MCP server"
        ;;
    pinboard-antigravity-session-start)
        session_client="Antigravity"
        reconnect_route="start a new agy session so Antigravity reconnects the plugin's pinboard MCP server"
        ;;
    pinboard-antigravity-pre-tool-use)
        # Antigravity sends every MCP server's calls through this hook and blocks a call whose hook fails, so an
        # unprepared runtime still answers: a forced prompt for any call naming pinboard_close, otherwise ask so
        # Antigravity's own approval settings decide. The preparation result goes to stderr.
        preparation_required '["Pinboard has no ready launcher-root private runtime; run the returned same-launcher preparation action before retrying the original command."]'
        if grep -q pinboard_close; then
            printf '{"decision":"force_ask","reason":"Pinboard runtime is not prepared; closing a Pinboard item always needs the human'"'"'s confirmation."}\n'
        else
            printf '{"decision":"ask","reason":"Pinboard runtime is not prepared; Antigravity'"'"'s own approval settings decide."}\n'
        fi
        exit 0
        ;;
    *)
        preparation_required '["Pinboard has no ready launcher-root private runtime; run the returned same-launcher preparation action before retrying the original command."]'
        exit 78
        ;;
esac
# SessionStart stdout is the agent's context channel, not a protocol stream. The hook is the
# nearest supported install trigger, so it runs the same explicit preparation path once and
# otherwise names the exact manual route instead of leaving the failed connection opaque.
hook_context() {
    if [ -n "$2" ]; then
        printf '%s\n' "$2" >&2
    else
        preparation_required '["Pinboard has no ready launcher-root private runtime; run the returned same-launcher preparation action before retrying the original command."]'
    fi
    escaped=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
    if [ "$session_client" = "Antigravity" ]; then
        printf '{"injectSteps":[{"systemMessage":{"systemMessage":"%s"}}]}\n' "$escaped"
    else
        printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$escaped"
    fi
    exit 0
}
manual_route="Run exactly $plugin_root/scripts/pinboard --prepare-runtime once with uv available; it writes only $plugin_root/.pinboard-runtime. When it reports runtime-ready, check Pinboard tool availability; $reconnect_route if the connection remains unavailable. Do not substitute another Python environment or an ad hoc uv command."
preparation_context="Pinboard's private runtime was unavailable when this SessionStart hook ran. MCP startup also attempts automatic preparation; this hook does not establish the connection's current status."
if ! command -v uv >/dev/null 2>&1; then
    hook_context "$preparation_context Pinboard could not prepare it automatically because uv is not on PATH. Tell the user. $manual_route" ""
fi
preparation=$("$0" --prepare-runtime </dev/null) || true
preparation_status=$(printf '%s' "$preparation" | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
if [ "$preparation_status" = "runtime-ready" ] && [ -f "$ready_marker" ] && [ -x "$runtime_executable" ]; then
    PINBOARD_RUNTIME_PREPARED_NOW=1 exec "$runtime_executable"
fi
if [ "$preparation_status" = "runtime-preparation-required" ]; then
    hook_context "$preparation_context Preparation is blocked by an existing lock at $preparation_lock or unavailable write access to $runtime_root. Follow the exact stderr diagnosis: wait for a running preparer, request the named directory access, or report a stale lock to the human before any removal. After preparation, check tool availability and reconnect only if still unavailable. $manual_route" "$preparation"
fi
hook_context "$preparation_context Pinboard tried to prepare it automatically during this session start and failed with status ${preparation_status:-unknown}; the launcher diagnostics are on this hook's stderr. Tell the user. $manual_route" "$preparation"
